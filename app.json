{
  "expo": {
    "name": "BioStack PRO",
    "slug": "biostackpro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "userInterfaceStyle": "dark",

    "splash": {
      "backgroundColor": "#030712"
    },

    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.biostack.pro",
      "icon": "./icon.png"
    },

    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./icon.png",
      "name": "BioStack PRO",
      "shortName": "BioStack"
    },

    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./icon.png",
          "color": "#10b981"
        }
      ]
    ]
  }
}
